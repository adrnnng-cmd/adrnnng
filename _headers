# Cache
/backtest/data/*
  Cache-Control: public, max-age=1800, must-revalidate

# Public registry the page fetches. `!` clears a publish.sh `/*` noindex
# before this value is set, so the two do not join. The fetch stays open.
/assets/tools.json
  Cache-Control: public, max-age=300
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

/assets/vendor/*
  Cache-Control: public, max-age=604800

# Modules and stylesheets pair with /assets/tools.json (five minutes), so they revalidate on the same horizon
# instead of Pages' four-hour default. An old module cached before this rule keeps its old max-age; the
# pages get past that with the content-hash ?v= stamps on every script, stylesheet and import
# (scripts/asset-versions.mjs).
/assets/js/*
  Cache-Control: public, max-age=300, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=300, must-revalidate

# Indexing.
# Cloudflare applies every matching rule in file order. A repeated
# X-Robots-Tag is joined with a comma, and a joined value that still contains
# noindex blocks the URL. `! X-Robots-Tag` removes what earlier rules attached;
# it does not remove a value a later rule sets. Detach on public HTML so a
# publish.sh `/*` noindex rule above these lines cannot stick. Do not set
# X-Robots-Tag on the detach rules themselves. /api and /thanks keep noindex.
# The JSON rules at the bottom set noindex after these detaches. publish.sh
# must stop emitting `/*` + `X-Robots-Tag: noindex, nofollow`.

/
  ! X-Robots-Tag

/index.html
  ! X-Robots-Tag

/backtest
  ! X-Robots-Tag

/backtest/
  ! X-Robots-Tag

/backtest/*
  ! X-Robots-Tag

/politician-tracker
  ! X-Robots-Tag

/politician-tracker/
  ! X-Robots-Tag

/politician-tracker/*
  ! X-Robots-Tag

/movers
  ! X-Robots-Tag

/movers/
  ! X-Robots-Tag

/movers/*
  ! X-Robots-Tag

/hsi-lab
  ! X-Robots-Tag

/hsi-lab/
  ! X-Robots-Tag

/hsi-lab/*
  ! X-Robots-Tag

/news
  ! X-Robots-Tag

/news/
  ! X-Robots-Tag

/news/*
  ! X-Robots-Tag

/news/feed.xml
  Content-Type: application/rss+xml; charset=utf-8

/robots.txt
  ! X-Robots-Tag

/llms.txt
  ! X-Robots-Tag

/sitemap.xml
  ! X-Robots-Tag

/sitemap-pages.xml
  ! X-Robots-Tag

/sitemap-news.xml
  ! X-Robots-Tag

/news-sitemap.xml
  ! X-Robots-Tag

/ae5543efbf2a5168fc9df6644b06bc38.txt
  ! X-Robots-Tag

/api
  X-Robots-Tag: noindex, nofollow

/api/
  X-Robots-Tag: noindex, nofollow

/api/*
  X-Robots-Tag: noindex, nofollow

# Browser JSON under the detach globs above. Keep these rules below
# /politician-tracker/* and /news/*. A later matching `!` would delete this
# header. HTML under those trees does not match these paths.
/politician-tracker/data.json
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

/news/latest.json
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

# Movers browser JSON. /movers/data/latest (and the old /hk-movers/data/latest, kept so the live
# feed and any cached page keep working) are Pages Functions; Pages does not apply this file to
# Function responses, so the Function sets the same noindex itself.
/movers/data/latest
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

/hk-movers/data/latest
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

/movers/data/sample.json
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=300

# Subscribe confirmation. Same noindex as /api. `!` then set so a prepended
# `/*` noindex does not join into a second value, and no later detach matches.
# Public HTML above only detaches; it does not match these paths.
/thanks
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

/thanks/
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

/thanks/*
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

# Favicon URLs also carry ?v=nc-2026-11-13 in HTML. Root /favicon.ico is still
# requested with no query by browsers, so it must revalidate after this NC swap.
/favicon.ico
  Cache-Control: public, max-age=3600, must-revalidate

/assets/brand/favicon.ico
  Cache-Control: public, max-age=3600, must-revalidate

/assets/brand/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate
