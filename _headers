# Cache
/backtest/data/*
  Cache-Control: public, max-age=1800, must-revalidate

# Public registry the page fetches. `!` clears a publish.sh `/*` noindex
# before this value is set, so the two do not join. The fetch stays open.
/assets/tools.json
  Cache-Control: public, max-age=300
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

/assets/vendor/*
  Cache-Control: public, max-age=604800

# Indexing.
# Cloudflare applies every matching rule in file order. A repeated
# X-Robots-Tag is joined with a comma, and a joined value that still contains
# noindex blocks the URL. `! X-Robots-Tag` removes what earlier rules attached;
# it does not remove a value a later rule sets. Detach on public HTML so a
# publish.sh `/*` noindex rule above these lines cannot stick. Do not set
# X-Robots-Tag on the detach rules themselves. /api and /thanks keep noindex.
# The JSON rules at the bottom set noindex after these detaches. publish.sh
# must stop emitting `/*` + `X-Robots-Tag: noindex, nofollow`.

/
  ! X-Robots-Tag

/index.html
  ! X-Robots-Tag

/backtest
  ! X-Robots-Tag

/backtest/
  ! X-Robots-Tag

/backtest/*
  ! X-Robots-Tag

/politician-tracker
  ! X-Robots-Tag

/politician-tracker/
  ! X-Robots-Tag

/politician-tracker/*
  ! X-Robots-Tag

/hsi-lab
  ! X-Robots-Tag

/hsi-lab/
  ! X-Robots-Tag

/hsi-lab/*
  ! X-Robots-Tag

/news
  ! X-Robots-Tag

/news/
  ! X-Robots-Tag

/news/*
  ! X-Robots-Tag

/news/feed.xml
  Content-Type: application/rss+xml; charset=utf-8

/robots.txt
  ! X-Robots-Tag

/llms.txt
  ! X-Robots-Tag

/sitemap.xml
  ! X-Robots-Tag

/sitemap-pages.xml
  ! X-Robots-Tag

/sitemap-news.xml
  ! X-Robots-Tag

/news-sitemap.xml
  ! X-Robots-Tag

/ae5543efbf2a5168fc9df6644b06bc38.txt
  ! X-Robots-Tag

/api
  X-Robots-Tag: noindex, nofollow

/api/
  X-Robots-Tag: noindex, nofollow

/api/*
  X-Robots-Tag: noindex, nofollow

# Browser JSON under the detach globs above. Keep these rules below
# /politician-tracker/* and /news/*. A later matching `!` would delete this
# header. HTML under those trees does not match these paths.
/politician-tracker/data.json
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

/news/latest.json
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

# Subscribe confirmation. Same noindex as /api. `!` then set so a prepended
# `/*` noindex does not join into a second value, and no later detach matches.
# Public HTML above only detaches; it does not match these paths.
/thanks
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

/thanks/
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow

/thanks/*
  ! X-Robots-Tag
  X-Robots-Tag: noindex, nofollow
